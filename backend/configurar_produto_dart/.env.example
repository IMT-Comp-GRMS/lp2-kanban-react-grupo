# Modelo de configuração do Configurar_Produto (Dart).
# Copie para ".env" e ajuste para rodar localmente com "dart run bin/server.dart".
# No Kubernetes estes valores vêm do configurar-produto-deployment.yaml.
APP_ENV=development
SERVER_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=BD_Produtos
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_POOL_SIZE=10
BARRAMENTO_URL=http://localhost:10000/eventos
